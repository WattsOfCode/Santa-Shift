<Project Sdk="Microsoft.NET.Sdk">
  <!-- Views, controllers and the Raylib window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Release builds are a windowed app, so Windows opens no console window next to the game. Debug keeps the console for logs. -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <RootNamespace>SantaShift.Game</RootNamespace>
    <AssemblyName>SantaShift</AssemblyName>
    <ApplicationIcon>Icon\santa_shift.ico</ApplicationIcon> <!-- Explorer / taskbar icon of SantaShift.exe; drawn by tools/icon/make_icon.py -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- Raylib pointers: model materials (lighting shader), animations and bone matrices -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SantaShift.Core\SantaShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data, models, textures and audio are copied next to the executable. -->
    <None Update="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licence, credits and notices ship with every build, next to the executable. -->
    <None Include="..\..\LICENSE.txt;..\..\THIRD_PARTY_NOTICES.md;..\..\ASSET_CREDITS.md" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
