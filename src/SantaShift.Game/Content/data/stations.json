// Workshop layout (GDD section 13), in logical pixels on the 960 x 540 canvas.
// body = solid box (centre x/y, width w, height h). interact = where the elf stands; keep it outside the body.
{
  "stations": [
    { "id": "kits_train", "type": "dispenser", "toyId": "train", "label": "TRAIN KITS",
      "body": { "x": 180, "y": 145, "w": 90, "h": 40 }, "interact": { "x": 180, "y": 180 }, "model": "station_bin.glb" },
    { "id": "kits_bear", "type": "dispenser", "toyId": "bear", "label": "BEAR KITS",
      "body": { "x": 500, "y": 145, "w": 90, "h": 40 }, "interact": { "x": 500, "y": 180 }, "model": "station_bin.glb" },
    { "id": "kits_robot", "type": "dispenser", "toyId": "robot", "label": "ROBOT KITS",
      "body": { "x": 660, "y": 145, "w": 90, "h": 40 }, "interact": { "x": 660, "y": 180 }, "model": "station_bin.glb" },
    // Boats join the line in round 5 (toys.json fromRound); the bin gives no kits until then. Between the train and
    // bear bins: the four bins are evenly spaced, 160 px (4 m) apart.
    { "id": "kits_boat", "type": "dispenser", "toyId": "boat", "label": "BOAT KITS",
      "body": { "x": 340, "y": 145, "w": 90, "h": 40 }, "interact": { "x": 340, "y": 180 }, "model": "station_bin.glb" },

    { "id": "bench", "type": "bench", "label": "ASSEMBLY BENCH",
      "body": { "x": 300, "y": 255, "w": 120, "h": 40 }, "interact": { "x": 300, "y": 285 }, "model": "station_bench.glb" },
    { "id": "ribbon", "type": "ribbon", "label": "RIBBON STATION",
      "body": { "x": 610, "y": 255, "w": 100, "h": 40 }, "interact": { "x": 610, "y": 285 }, "model": "station_ribbon.glb" },

    { "id": "recycle", "type": "recycle", "label": "RECYCLE",
      "body": { "x": 120, "y": 420, "w": 50, "h": 50 }, "interact": { "x": 165, "y": 420 }, "model": "station_recycle.glb" },
    { "id": "shipping", "type": "shipping", "label": "SHIPPING",
      "body": { "x": 830, "y": 420, "w": 70, "h": 60 }, "interact": { "x": 780, "y": 420 }, "model": "station_shipping.glb" },

    // Coal scuttle on the fireplace hearth: coal for children on the naughty list. Optional: without it, nobody is naughty.
    { "id": "coal", "type": "coal", "label": "COAL",
      "body": { "x": 66, "y": 300, "w": 24, "h": 24 }, "interact": { "x": 104, "y": 300 }, "model": "station_coal.glb" },

    // Supply sled against the right wall: crates of spare kits. With it in the room, kit bins are filled once per shift with
