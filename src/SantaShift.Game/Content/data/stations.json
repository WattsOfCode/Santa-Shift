    { "id": "supply", "type": "supply", "label": "SUPPLY SLED", "yaw": -90,
      "body": { "x": 904, "y": 280, "w": 48, "h": 80 }, "interact": { "x": 858, "y": 280 }, "model": "station_supply.glb" },

    // Punch clock on the left wall, beside the workshop door: punch your card (use twice) to end the shift early.
    // Optional: without it, every shift runs its full time.
    { "id": "clock", "type": "clock", "label": "PUNCH CLOCK", "yaw": 90,
      "body": { "x": 29, "y": 164, "w": 18, "h": 40 }, "interact": { "x": 62, "y": 164 }, "model": "station_clock.glb" }
  ]
