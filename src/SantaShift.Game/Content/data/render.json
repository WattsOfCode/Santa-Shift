// Display settings for the Raylib window (not gameplay). Lower internalWidth/Height for very weak devices;
// the picture is drawn at this size and scaled to the window, so cost stays flat on big screens.
{
  "internalWidth": 960,
  "internalHeight": 540,
  "windowWidth": 1280,
  "windowHeight": 720,
  "vsync": true,
  "targetFps": 60,
  "msaa": false,

  // Third-person camera behind the elf. The mouse turns it; WASD moves relative to it.
  "chaseCamera": {
    "distance": 3.8,           // metres behind the elf
    "targetHeight": 1.55,      // the point it looks at (above the head, so the elf sits low in the view)
    "pitchDegrees": 12,        // starting downward tilt
    "minPitchDegrees": 5,
    "maxPitchDegrees": 60,
    "fovDegrees": 60,
    "mouseSensitivity": 0.15,  // degrees per pixel of mouse movement
    "invertY": false,
    "wallMargin": 0.25,        // keeps the camera this far inside the walls
    "maxHeight": 3.0           // keeps the camera below the cabin ceiling beams
  },

  // Fixed view behind the title and results screens, in metres.
  "menuCamera": {
    "position": { "x": 0, "y": 2.8, "z": 4.0 },
    "target": { "x": 0, "y": 0.8, "z": -1.5 },
    "fovDegrees": 60
  }
}
