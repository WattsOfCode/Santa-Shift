// Display settings for the Raylib window (not gameplay).
// The 3D picture is drawn at the window's resolution times Settings > Game > 3D resolution (50-150%), never wider
// than maxRenderWidth, then edge-smoothed (FXAA) and scaled to the window. The UI always uses the 960 x 540 canvas.
// With followWindow false, the picture is always internalWidth x internalHeight (cost stays flat on big screens).
// The frame rate is a player setting (Settings > Game > Frame rate, 120 by default), not set here.
{
  "followWindow": true,
  "maxRenderWidth": 2560,
  "internalWidth": 960,
  "internalHeight": 540,
  "windowWidth": 1280,
  "windowHeight": 720,
  "msaa": false,

  // Third-person camera behind the elf. The mouse turns it; WASD moves relative to it.
  "chaseCamera": {
    "distance": 3.4,           // metres behind the elf
    "targetHeight": 1.05,      // the point it looks at (above the head, so the elf sits low in the view)
    "pitchDegrees": 12,        // starting downward tilt
    "minPitchDegrees": 5,
    "maxPitchDegrees": 60,
    "fovDegrees": 60,
    "mouseSensitivity": 0.15,  // degrees per pixel of mouse movement
    "invertY": false,
    "wallMargin": 0.25,        // keeps the camera this far inside the walls
    "maxHeight": 3.0,          // keeps the camera below the cabin ceiling beams
    "autoFollowSeconds": 2.0,  // after facing one way this long (mouse untouched), swing round behind the elf; 0 = off
    "autoFollowSpeed": 2.5     // how quickly it swings round
  },

  // How the elf turns and gets going (feel only).
  "movement": {
    "turnDegreesPerSecond": 720,
    "accelerationSeconds": 0.12,  // time to reach full speed
    "turningSpeedFloor": 0.2      // slows to this fraction of full speed while coming round a sharp turn
  },

  // While building a toy at the bench, the camera moves in over the elf's right shoulder (metres).
  "shoulderCamera": {
    "back": 0.85,          // behind the elf, along its line of sight to the toy
    "side": 0.75,          // to the elf's right
    "height": 1.7,         // above the elf's hat, looking down at the bench
    "lookAbove": 0.12,     // looks this far above the bench top
    "fovDegrees": 55,
    "blendSeconds": 0.35   // time to swing in and out
  },

  // Source-based lighting (fireplace, lanterns, windows and tree light the cabin; see Views/World/Lighting.cs).
  // quality: "high" = 16 lights, "medium" = 8, "low" = 4 lights with no haze or vignette (for weak devices).
  "lighting": {
    "quality": "high",
    "exposure": 2.0,              // overall brightness after tone mapping
    "emissiveBoost": 1.3,         // how strongly flames, lantern glass and windows glow
    "ambientSky": [0.13, 0.13, 0.18],      // soft light from above (cool)
    "ambientGround": [0.19, 0.12, 0.08],   // soft light from below (warm floor bounce)
    "directionalColor": [0.10, 0.11, 0.15], // faint moonlight
    "fogColor": [0.05, 0.03, 0.02],
    "fogDensity": 0.018,
    "vignette": 0.45,
    "saturation": 1.15,
    "playerFill": 0.45            // soft light following the elf so it stays readable (0 = off)
  },

  // Fixed view behind the title and results screens, in metres.
  "menuCamera": {
    "position": { "x": 0, "y": 2.8, "z": 4.0 },
    "target": { "x": 0, "y": 0.8, "z": -1.5 },
    "fovDegrees": 60
  }
}
