// Gameplay numbers (GDD sections 8, 9, 12, 13). Times in seconds, distances in logical pixels.
// Any value left out uses the default in SantaShift.Core/Content/Tuning.cs.
{
  "ticksPerSecond": 60,
  "shiftSeconds": 300,

  "playerSpeed": 200,
  "interactRange": 54,
  "playerStart": { "x": 470, "y": 410 },
  "playerColliderWidth": 22,
  "playerColliderHeight": 18,
  "floor": { "left": 20, "top": 120, "right": 940, "bottom": 480 },

  "ribbonSeconds": 1.0,

  // The bench minigame: enter the toy's build combination (toys.json "variants") before time runs out. The time
  // limit is for a toy of baseParts parts (a longer combination gets more in proportion) and shrinks each round.
  // From variantsFromRound some letters ask for a toy variant (big wheels, a big bear, a rocket pack), each with its
  // own combination: variantShare of the letters that round, plus variantSharePerRound each round after, up to
  // maxVariantShare. From hideRecipesFromRound the bench stops listing the combinations (0 = always list them).
  // Relaxed mode plays relaxedRoundOffset rounds behind, with relaxedTimeMultiplier times as long.
  "assembly": {
    "timeLimitSeconds": 6.0,
    "timeLimitDecreasePerRound": 0.5,
    "minTimeLimitSeconds": 2.5,
    "baseParts": 3,
    "variantsFromRound": 2,
    "variantShare": 0.25,
    "variantSharePerRound": 0.1,
    "maxVariantShare": 0.5,
    "hideRecipesFromRound": 5,
    "relaxedRoundOffset": 1,
    "relaxedTimeMultiplier": 1.5
  },

  "spawnTimes": [0, 18, 36, 54, 72, 90, 108, 126, 144, 162, 180, 198, 216, 234, 252],
  "maxLiveOrders": 3,

  // From round fromRound the training wheels come off: letters arrive every intervalSeconds (minus
  // intervalDecreasePerRound each round, down to minIntervalSeconds), the board holds up to maxLiveOrders, and whenever
  // fewer than minLiveOrders are waiting the next letter comes early (at most one per refillSeconds), drawing on
  // reserveLetters extra letters if the schedule runs out. Relaxed mode spaces letters relaxedIntervalMultiplier apart.
  "flow": {
    "fromRound": 2,
    "maxLiveOrders": 10,
    "minLiveOrders": 2,
    "refillSeconds": 2,
    "intervalSeconds": 16,
    "intervalDecreasePerRound": 1.5,
    "minIntervalSeconds": 10,
    "relaxedIntervalMultiplier": 1.25,
    "lastLetterSeconds": 260,
    "reserveLetters": 6
  },
  // The toys letters ask for, in turn. A toy with a later "fromRound" (toys.json) joins the turn from that round.
  "toySequence": ["train", "bear", "robot", "boat"],
  "deadlineSeconds": 55,
  "ribbonDeadlineSeconds": 65,
  "rushDeadlineSeconds": 45,
  "relaxedDeadlineMultiplier": 1.5,

  // Santa's naughty and nice list: at the start of each run this many children (from letters.json) are marked naughty.
  // Their orders want a lump of coal from the fireplace instead of their toy.
  "naughtyPerRun": 3,

  // With a supply sled in the room, Santa fills each kit bin once when a shift starts: one kit per toy the shift's letters
  // will ask for, never topped up. A botched or scrapped kit leaves a bin short: fetch a supply crate from the sled.
  "resupplyKits": 2,

  // The guided first round (until a round is cleared): its first `orders` orders show every job, with coal as order
  // `coalOrder` and a ribbon as `ribbonOrder`. With shortKit, Santa's sack is one kit short for the last lesson order's
  // toy (asked for nowhere else that round), so the lesson ends with a trip to the supply sled.
  "tutorial": { "orders": 6, "coalOrder": 3, "ribbonOrder": 5, "shortKit": true },

  // Ribbon colours at the ribbon station (up to 9; spool n is on part key n). Ribbon orders ask for one of them.
  // Remove them all for plain ribbons that any order accepts.
  "ribbonColors": [
    { "id": "red",   "name": "Red",   "color": "#C8323A" },
    { "id": "gold",  "name": "Gold",  "color": "#E8BB57" },
    { "id": "green", "name": "Green", "color": "#2F8A52" }
  ],

  // The toy cart, built over each run: every passed round adds the next of its parts, so with three parts it works from
  // round 4. Then it holds up to `capacity` finished toys (put in and taken out one at a time at the parked cart), and
  // the elf can push it at speedMultiplier times walking speed. It starts every shift at `home` (logical pixels,
  // between the tree and the robot bin). pushDistance: how far ahead of the elf it rolls; turnRate: how fast it swings
  // round (0..1 per step). Remove all parts for no cart.
  "cart": {
    "parts": ["Wheels", "Toy tray", "Push handle"],
    "capacity": 3,
    "speedMultiplier": 0.75,
    "home": { "x": 780, "y": 172 },
    "pushDistance": 30,
    "turnRate": 0.12
  },

  // Perk cards offered after a passed round (perks.json), plus one more when the round beat its quota by bonusPerkMargin.
  "perkOffers": 3,
  "bonusPerkMargin": 2,

  // The Christmas Spirit meter lasts the whole run: deliveries raise it, missed orders and botched toys lower it, and
  // it recovers a little between rounds. At or above jollyAt deliveries earn jollyBonus more points; at 0 the shift
  // ends there and the run is over.
  "spirit": {
    "enabled": true,
    "start": 100, "max": 100,
    "delivered": 4, "coalDelivered": 4,
    "missed": 20, "botched": 8,
    "betweenRounds": 15,
    "jollyAt": 75, "jollyBonus": 0.1
  },

  "score": { "base": 100, "ribbonBonus": 25, "rushBonus": 25, "timeBonusMax": 20, "streakStep": 5, "streakCap": 4 },
  "quota": 9,
  "relaxedQuota": 6,
  "survivorDelivered": 9,
  "legendDelivered": 12,

  // Rounds: meeting the quota starts the next round; missing it ends the run.
  // quotaIncreases: extra deliveries needed in round 2, round 3... (round 2 opens the floodgates, round 3 raises the
  // demands); after the list, quotaIncrease more each round. Standard: 9, 10, 13, 15, 17...  Relaxed: 6, 7, 9, 10, 11...
  // Rush shifts: from round rushShiftFrom, every rushShiftEvery rounds, every order of the shift is RUSH (0 = never).
  "rounds": {
    "quotaIncreases": [1, 3], "quotaIncrease": 2,
    "relaxedQuotaIncreases": [1, 2], "relaxedQuotaIncrease": 1,
    "rushShiftFrom": 4, "rushShiftEvery": 3,
    "deadlineMultiplierPerRound": 0.95, "minDeadlineMultiplier": 0.7
  },

  // World scale shared with the Blender room export: 40 logical pixels = 1 metre, and pixel (480, 300) is the world origin.
  "pixelsPerMetre": 40,
  "worldOrigin": { "x": 480, "y": 300 }
}
