// All player-facing text (GDD section 15).
// cues: Santa's flavour line plus the plain mechanical text shown with it.
// messages: functional text. {0}, {1} are filled in by the game (toy name, points...). [use] becomes the key or
// controller button the player has bound to "use" (E by default).
{
  "cues": {
    "intro":          { "santa": "Welcome aboard. We are one big festive family. Your break is next year.", "text": "Collect a train kit." },
    "ribbon_warning": { "santa": "A memo from Branding. Apparently joy needs a bow.", "text": "Ribbon orders start in 5 seconds." },
    "ribbon_start":   { "santa": "Every present deserves presentation. Especially mine.", "text": "New orders need ribbons for 30 seconds." },
    "rush_warning":   { "santa": "I promised a very important child a very impossible deadline.", "text": "Rush orders start in 5 seconds." },
    "ribbon_second":  { "santa": "Good news: the festive compliance initiative is now standard.", "text": "New orders need ribbons for 30 seconds." },
    "final_rush":     { "santa": "One last tiny favour. It's only Christmas at stake.", "text": "Rush orders start in 5 seconds." },
    "quota_met":      { "santa": "Excellent. I shall mention my leadership in the newsletter.", "text": "Quota reached! Keep going for a higher score." },
    "review_pass":    { "santa": "Another successful Christmas. My system works beautifully.", "text": "Shift complete." },
    "review_miss":    { "santa": "Let's call this a development opportunity.", "text": "Quota missed. Try another shift." },
    "punched_out":    { "santa": "Clocking off early? The quota's met, so... fine. I'll note your enthusiasm.", "text": "Punched out early." },
    "rush_start":     { "santa": "Faster, please. Faster is festive.", "text": "New orders are RUSH for 30 seconds." },
    "rush_final":     { "santa": "Last push! Think of the bonus I'll get.", "text": "New orders are RUSH for 30 seconds." },
    "rush_shift":     { "santa": "Big news: this whole shift is a rush job. I believe in you. Mostly.", "text": "Rush shift: every order is RUSH." },
    "assembly_variants": { "santa": "Market research says children want MORE. Big wheels, big bears, rockets.", "text": "Assembly policy update: some letters ask for a toy variant" },
    "assembly_memory":   { "santa": "Engineering has recalled the instruction sheets. You know them by now. Surely.", "text": "Assembly policy update: build from memory" },
    "cart_ready":     { "santa": "I had Facilities build you a cart. Three toys a trip. I expect three times the joy.", "text": "The toy cart is ready: load finished toys and push it" },
    "new_toy_boat":   { "santa": "Boats! Children want boats now. Don't ask me, I only run the place.", "text": "New toy: boats. Kits are in the boat bin" },
    "naughty_order":  { "santa": "Ho ho... no. Coal, please. The good stuff.", "text": "" },
    "spirit_out":     { "santa": "The workshop has lost its sparkle. Christmas is... postponed.", "text": "The Christmas spirit ran out." }
  },
