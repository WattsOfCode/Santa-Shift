    { "id": "perk_reindeer", "name": "Express Reindeer", "stat": "bestRound",     "target": 3,  "reward": "perk", "value": "reindeer",
      "description": "Santa can offer the Express Reindeer perk." },
    { "id": "hat_gold",      "name": "Golden Hat",       "stat": "toysDelivered", "target": 50, "reward": "hat",  "value": "#E8BB57",
      "description": "A shiny gold hat for the elf." },
